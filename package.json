{
  "name": "auditorium-management",
  "version": "2.0.0",
  "private": true,
  "description": "Kirti Auditorium Management System — Unified PWA (Faculty + Admin + Student)",
  "workspaces": [
    "backend",
    "webapp"
  ],
  "scripts": {
    "server": "npm run start --workspace=backend",
    "webapp": "npm run dev --workspace=webapp",
    "dev": "concurrently -n \"SERVER,APP\" -c \"blue,green\" \"npm run server\" \"npm run webapp\"",
    "build": "npm run build --workspace=webapp",
    "install-backend": "npm install --workspace=backend",
    "install-webapp": "npm install --workspace=webapp",
    "install-all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}